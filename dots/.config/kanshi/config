profile wdocked {
  output HDMI-A-1 enable mode 3440x1440
  output eDP-1 disable
  exec swaymsg input "type:keyboard" xkb_options caps:caps
}

profile wundocked {
  output "AU Optronics 0x0BA4 Unknown" enable mode 2560x1600
  exec swaymsg input "type:keyboard" xkb_options caps:ctrl_modifier
}

profile docked {
  output DP-8 enable mode 3440x1440
  output eDP-1 disable
  exec swaymsg input "type:keyboard" xkb_options caps:caps
}

profile undocked {
  output eDP-1 enable mode 1920x1200
  exec swaymsg input "type:keyboard" xkb_options caps:ctrl_modifier
}
