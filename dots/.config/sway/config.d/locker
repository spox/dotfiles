# Idle configuration
exec swayidle -w \
    timeout 600 'swaylock --config ~/.config/swaylock/config' \
    timeout 800 'swaymsg "output * power off"' \
    timeout 3600 'systemctl suspend' \
    after-resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f --config ~/.config/swaylock/config'

bindsym $mod+z exec /usr/bin/swaylock --config ~/.config/swaylock/config
bindsym $mod+Shift+z exec systemctl suspend
