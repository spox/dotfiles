# Idle configuration
exec swayidle -w \
    timeout 600 '/usr/bin/swaylock --image ~/.config/wallpaper --config ~/.config/swaylock/config' \
    after-resume 'swaymsg "output * power on"' \
    before-sleep '/usr/bin/swaylock --image ~/.config/wallpaper --daemonize --config ~/.config/swaylock/config'

# Lockers
bindsym $mod+z exec /usr/bin/swaylock --config ~/.config/swaylock/config
bindsym $mod+Shift+z exec systemctl suspend

# Ensure the xdg stuff is all running
exec "/home/spox/.nix-profile/libexec/xdg-desktop-portal" -r
exec "/home/spox/.nix-profile/libexec/xdg-desktop-portal-wlr" -r
