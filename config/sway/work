# Idle configuration
exec swayidle -w \
    timeout 600 '/usr/bin/swaylock --config ~/.config/swaylock/config' \
    timeout 800 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '/usr/bin/swaylock -f --config ~/.config/swaylock/config'

bindsym $mod+z exec /usr/bin/swaylock --config ~/.config/swaylock/config
bindsym $mod+Shift+z exec systemctl suspend
